{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend/",
      "framework": "nestjs",
      "installCommand": "npm install --no-audit --no-fund",
      "buildCommand": "npm run build"
    },
    "frontend": {
      "root": "frontend/",
      "framework": "angular",
      "outputDirectory": "dist/frontend/browser"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}