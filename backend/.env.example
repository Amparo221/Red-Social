# ============================================================================
# Variables de entorno del backend (copiar este archivo como .env)
# El .env real NUNCA se sube al repositorio (está en .gitignore).
# ============================================================================

# --- MongoDB Atlas -----------------------------------------------------------
# Cadena de conexión del cluster. NO se escribe el nombre de la base al final:
# la base se elige con MONGODB_DB.
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster0.xxxxxxx.mongodb.net/
MONGODB_DB=redsocial

# --- Cloudinary --------------------------------------------------------------
# Dashboard de Cloudinary -> Settings -> API Keys
CLOUD_NAME=tu_cloud_name
API_KEY=tu_api_key
API_SECRET=tu_api_secret

# --- Aplicación --------------------------------------------------------------
PORT=3000
# URL pública de la imagen de perfil por defecto.
# La genera una sola vez el script: node scripts/upload-default-avatar.js
DEFAULT_AVATAR_URL=https://res.cloudinary.com/tu_cloud_name/image/upload/red-social/perfiles/default.png
